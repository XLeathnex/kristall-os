{
  "_comment": [
    "Vocabulary of the risky-target gate (kristall_hands/riskgate.py, docs/contracts/hands.md §10).",
    "Matching is case-insensitive on whole words, after normalisation: Unicode NFKC, casefold (ß = ss),",
    "mnemonics (& _) removed, punctuation and ellipses turned into spaces.",
    "A term is a string (strong) or an object: {\"t\": phrase, \"weak\": true, \"apps\": [...], \"not_apps\": [...]}.",
    "  weak: does not count when one of the class's 'unless' phrases occurs in the same text, or when the",
    "        element is a menu item of a text-editing menu (Cut/Copy/Paste/Select all) or the window's focus",
    "        is in an editable text field.",
    "  apps / not_apps: names of app_groups or app ids; the term counts only inside / outside those apps.",
    "When several classes match, the strictest category in the policy order wins (credentials > purchase >",
    "send > files.delete > apps.install). Extend by adding terms; tests/test_riskgate.py checks the file."
  ],
  "version": 1,
  "app_groups": {
    "file_managers": ["dolphin", "org.kde.dolphin", "nautilus", "org.gnome.nautilus", "nemo", "thunar",
                      "pcmanfm", "pcmanfm-qt", "krusader", "org.kde.krusader", "caja", "spacefm"],
    "software_stores": ["bazaar", "io.github.kolunmi.bazaar", "plasma-discover", "discover", "org.kde.discover",
                        "gnome-software", "org.gnome.software", "kristall-apps"],
    "calculators": ["kcalc", "org.kde.kcalc", "kalk", "org.kde.kalk", "gnome-calculator", "org.gnome.calculator",
                    "qalculate", "qalculate-gtk", "qalculate-qt", "io.github.qalculate.qalculate-qt"],
    "disk_tools": ["partitionmanager", "org.kde.partitionmanager", "gnome-disks", "org.gnome.diskutility",
                   "gparted", "isoimagewriter", "org.kde.isoimagewriter", "kdf"]
  },
  "harmless": ["abbrechen", "schließen", "schliessen", "nein", "zurück", "hilfe", "später", "nicht jetzt",
               "verwerfen", "minimieren", "maximieren", "cancel", "close", "no", "back", "help", "later",
               "not now", "dismiss", "minimize", "maximize"],
  "affirmative": ["ok", "okay", "ja", "ja bitte", "bestätigen", "fortfahren", "weiter", "übernehmen", "anwenden",
                  "akzeptieren", "einverstanden", "trotzdem fortfahren", "yes", "confirm", "continue", "proceed",
                  "apply", "accept", "agree", "i agree", "go ahead"],
  "negation_prefixes": ["nicht", "kein", "keine", "niemals", "don't", "do not", "never", "not", "no"],
  "text_menu_markers": ["alles auswählen", "alles markieren", "select all", "einfügen", "paste", "rückgängig", "undo"],
  "item_menu_markers": ["umbenennen", "rename", "eigenschaften", "properties", "öffnen mit", "open with",
                        "in den papierkorb", "in den papierkorb verschieben", "move to trash", "nachricht",
                        "message", "ordner", "folder"],
  "classes": [
    {
      "class": "account",
      "category": "credentials",
      "label": {"de": "ändert dein Konto oder Passwort", "en": "changes your account or password"},
      "terms": ["abmelden von konto", "vom konto abmelden", "von konto abmelden", "konto abmelden",
                "von allen geräten abmelden", "konto löschen", "konto entfernen", "konto schließen",
                "konto kündigen", "passwort ändern", "kennwort ändern", "passwort zurücksetzen",
                "kennwort zurücksetzen", "passwort festlegen", "sign out of account", "sign out of your account",
                "sign out of all devices", "sign out everywhere", "log out of account", "log out of your account",
                "delete account", "delete my account", "delete your account", "remove account", "close account",
                "close my account", "change password", "reset password", "set password", "change your password"],
      "unless": []
    },
    {
      "class": "purchase",
      "category": "purchase",
      "label": {"de": "kostet Geld", "en": "costs money"},
      "terms": ["kaufen", "jetzt kaufen", "sofort kaufen", "bestellen", "jetzt bestellen", "zahlungspflichtig bestellen",
                "kostenpflichtig bestellen", "bezahlen", "jetzt bezahlen", "jetzt zahlen", "zur kasse", "zur kasse gehen",
                "abonnieren", "abo abschließen", "überweisen", "überweisung ausführen", "jetzt überweisen", "mieten",
                "spenden",
                "buy", "buy now", "order now", "place order", "place your order", "pay", "pay now", "checkout",
                "proceed to checkout", "subscribe", "purchase", "complete purchase", "rent", "donate",
                {"t": "order", "weak": true}, {"t": "transfer", "weak": true}],
      "unless": ["sort order", "order by", "in order", "out of order", "reihenfolge", "file transfer",
                 "data transfer", "transfer files", "transfer ownership"]
    },
    {
      "class": "send",
      "category": "send",
      "label": {"de": "sendet etwas in deinem Namen", "en": "sends something on your behalf"},
      "terms": ["senden", "jetzt senden", "absenden", "abschicken", "verschicken", "antworten an alle", "allen antworten",
                "posten", "veröffentlichen", "hochladen", "einreichen", "twittern", "tweeten",
                {"t": "teilen", "weak": true, "not_apps": ["calculators", "file_managers"]},
                {"t": "send", "weak": true}, "send now", "submit", "publish", "upload", "reply all", "reply to all", "tweet", "retweet",
                {"t": "post", "weak": true}, {"t": "share", "not_apps": ["file_managers"]}],
      "unless": ["send to back", "send backward", "send backwards", "send to background", "ansicht teilen",
                 "fenster teilen", "geteilte ansicht", "post office", "post it"]
    },
    {
      "class": "delete",
      "category": "files.delete",
      "label": {"de": "löscht endgültig", "en": "deletes permanently"},
      "terms": ["endgültig löschen", "dauerhaft löschen", "unwiderruflich löschen", "permanent löschen",
                "endgültig gelöscht", "dauerhaft gelöscht", "unwiderruflich gelöscht", "papierkorb leeren",
                "papierkorb jetzt leeren",
                "delete permanently", "permanently delete", "permanently deleted", "deleted permanently",
                "empty trash", "empty the trash", "empty wastebasket", "wipe", "erase",
                {"t": "alle löschen", "weak": true, "not_apps": ["calculators"]},
                {"t": "alles löschen", "weak": true, "not_apps": ["calculators"]},
                {"t": "delete all", "weak": true, "not_apps": ["calculators"]},
                {"t": "löschen", "weak": true, "not_apps": ["calculators"]},
                {"t": "delete", "weak": true, "not_apps": ["calculators"]},
                {"t": "entfernen", "weak": true, "apps": ["file_managers"]},
                {"t": "remove", "weak": true, "apps": ["file_managers"]},
                {"t": "formatieren", "apps": ["disk_tools", "file_managers"]},
                {"t": "format", "apps": ["disk_tools", "file_managers"]}],
      "unless": ["in den papierkorb", "papierkorb verschieben", "move to trash", "move to the trash", "to trash",
                 "text löschen", "auswahl löschen", "eingabe löschen", "markierung löschen", "formatierung löschen",
                 "zeichen löschen", "wort löschen", "zeile löschen", "delete text", "delete selection",
                 "delete selected text", "delete character", "delete word", "delete line", "clear formatting"]
    },
    {
      "class": "install",
      "category": "apps.install",
      "label": {"de": "installiert oder entfernt Software", "en": "installs or removes software"},
      "terms": ["installieren", "jetzt installieren", "deinstallieren", "install", "install now", "uninstall",
                {"t": "entfernen", "apps": ["software_stores"]}, {"t": "remove", "apps": ["software_stores"]},
                {"t": "aktualisieren", "apps": ["software_stores"]}, {"t": "alle aktualisieren", "apps": ["software_stores"]},
                {"t": "update", "apps": ["software_stores"]}, {"t": "update all", "apps": ["software_stores"]}],
      "unless": []
    }
  ]
}
