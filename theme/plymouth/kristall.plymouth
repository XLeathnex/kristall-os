[Plymouth Theme]
Name=Kristall
Description=Kristall OS: the mark and a thin progress bar on black, like a Mac starting up
ModuleName=two-step

[two-step]
Font=Inter 12
TitleFont=Inter 20
MonospaceFont=JetBrains Mono 11
ImageDir=/usr/share/plymouth/themes/kristall
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.62
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.30
HorizontalAlignment=.5
VerticalAlignment=.62
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.62
ProgressBarWidth=200
ProgressBarHeight=4
ProgressBarBackgroundColor=0x3a3a3c
ProgressBarForegroundColor=0xf2f2f7
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
MessageBelowAnimation=true

[boot-up]
UseProgressBar=true
UseAnimation=false
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseProgressBar=false
UseAnimation=false
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseProgressBar=false
UseAnimation=false
UseEndAnimation=false
UseFirmwareBackground=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
UseAnimation=false
Title=Updates werden installiert … / Installing updates…
SubTitle=Bitte nicht ausschalten / Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
UseAnimation=false
Title=System wird aktualisiert … / Upgrading the system…
SubTitle=Bitte nicht ausschalten / Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
UseAnimation=false
Title=Firmware wird aktualisiert … / Updating firmware…
SubTitle=Bitte nicht ausschalten / Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
UseAnimation=false
Title=System wird zurückgesetzt … / Resetting the system…
SubTitle=Bitte nicht ausschalten / Do not turn off your computer
