# Kristall theme: merged into /etc/xdg/kwinrc (keys of other components, e.g. [Plugins] of the
# glass effect, are preserved).
[org.kde.kdecoration2]
library=org.kristall.decoration
theme=Kristall
ButtonsOnLeft=XIA
ButtonsOnRight=
BorderSize=None
BorderSizeAuto=false
ShowToolTips=false
CloseOnDoubleClickOnMenu=false

[Windows]
Placement=Centered
TitlebarDoubleClickCommand=Maximize
FocusPolicy=ClickToFocus
ElectricBorderMaximize=true
ElectricBorderTiling=true
ElectricBorderCornerRatio=0.25
ElectricBorderDelay=150
ElectricBorders=0
BorderlessMaximizedWindows=false

[MouseBindings]
CommandActiveTitlebar2=Nothing
CommandInactiveTitlebar2=Nothing

[ElectricBorders]
Top=None
TopRight=None
Right=None
BottomRight=None
Bottom=None
BottomLeft=None
Left=None
TopLeft=None

[TouchEdges]
Top=None
Right=None
Bottom=None
Left=None

[Effect-overview]
BorderActivate=9
GridBorderActivate=9
TouchBorderActivate=9
GridTouchBorderActivate=9

[Effect-windowview]
BorderActivate=9
BorderActivateAll=9
BorderActivateClass=9

[Effect-scale]
Duration=200
InScale=0.92
OutScale=0.92

[Effect-magiclamp]
AnimationDuration=350

[Plugins]
scaleEnabled=true
glideEnabled=false
fadeEnabled=false
magiclampEnabled=true
squashEnabled=false
maximizeEnabled=true
slideEnabled=true
