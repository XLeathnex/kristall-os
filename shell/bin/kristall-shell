#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts the Kristall shell (Quickshell) — ExecStart of kristall-shell.service.
# Crash ladder (docs/contracts/shell.md §8): systemd restarts us after a crash; if the shell
# started 3 times within 60 s, the next start is in safe mode (core + menu bar, no modules), so a
# broken module that crashes the whole process cannot keep the owner from their desktop.
# If even that keeps failing, systemd's start limit triggers kristall-shell-fallback.service.
set -u
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/kristall"
mkdir -p "$runtime" && chmod 0700 "$runtime"
starts="$runtime/shell-starts"
now=$(date +%s)
recent=0
if [[ -f $starts ]]; then
    while read -r t; do
        [[ $t =~ ^[0-9]+$ ]] && (( now - t < 60 )) && recent=$((recent + 1))
    done <"$starts"
fi
{ [[ -f $starts ]] && tail -n 9 "$starts"; echo "$now"; } >"$starts.tmp" && mv -f "$starts.tmp" "$starts"

export KRISTALL_SHELL_HELPER="${KRISTALL_SHELL_HELPER:-/usr/lib/kristall/shell/kristall-shell-helper}"
shell_dir="${KRISTALL_SHELL_DIR:-/usr/share/kristall/shell}"
if (( recent >= 3 )); then
    echo "kristall-shell: $recent starts within 60 s — starting in safe mode (modules off)" >&2
    export KRISTALL_SHELL_SAFE=1
fi
# Quickshell logs to stderr (journald: SyslogIdentifier=kristall-shell)
exec quickshell --no-duplicate -p "$shell_dir"
