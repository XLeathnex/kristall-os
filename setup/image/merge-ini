# merge-ini TARGET FRAGMENT — sets the fragment's keys in TARGET (a KDE ini file under /etc/xdg),
# keeping every other group and key; creates TARGET if missing; atomic replace.
import configparser
import os
import sys

target, fragment = sys.argv[1], sys.argv[2]


def load(path):
    cp = configparser.RawConfigParser(strict=False, interpolation=None, comment_prefixes=("#", ";"))
    cp.optionxform = str
    if os.path.exists(path):
        cp.read(path, encoding="utf-8")
    return cp


t, f = load(target), load(fragment)
for sec in f.sections():
    if not t.has_section(sec):
        t.add_section(sec)
    for k, v in f.items(sec):
        t.set(sec, k, v)
os.makedirs(os.path.dirname(target) or ".", exist_ok=True)
with open(target + ".tmp", "w", encoding="utf-8") as out:
    t.write(out, space_around_delimiters=False)
os.replace(target + ".tmp", target)
