#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# systemd generator (Kristall OS power component): on Intel hybrid CPUs, confine
# kristall-background.slice to the efficiency cores. The kernel exports them in
# /sys/devices/cpu_atom/cpus; on other CPUs nothing is generated. Must never fail.
out=${1:-}
[ -n "$out" ] || exit 0
cpus=$(cat "${KRISTALL_POWER_SYSFS:-/sys}/devices/cpu_atom/cpus" 2>/dev/null) || exit 0
case "$cpus" in
  '' | *[!0-9,-]*) exit 0 ;;
esac
mkdir -p "$out/kristall-background.slice.d" 2>/dev/null || exit 0
printf '# generated by kristall-power-ecores\n[Slice]\nAllowedCPUs=%s\n' "$cpus" \
  >"$out/kristall-background.slice.d/50-kristall-ecores.conf" 2>/dev/null || true
exit 0
