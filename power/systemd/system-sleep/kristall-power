#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# systemd-sleep hook (Kristall OS power component): many laptop firmwares reset the package
# power limits on resume; put ours back (the service re-checks twice and exits).
case "$1" in
  post) systemctl --no-block start kristall-power-reapply.service >/dev/null 2>&1 || true ;;
esac
exit 0
